DATABASE_URL=postgresql://answerpg:answerpg@localhost:5432/answerpg

# extractive (local and free) or anthropic
ANSWER_BACKEND=extractive
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5-5
ANSWER_EFFORT=low

# When set, every POST and DELETE route expects this value in an X-API-Token header
API_TOKEN=

CONTEXT_K=5
SEARCH_DEPTH=40
RERANK_DEPTH=20
